PORT=5000
NODE_ENV=development

# PostgreSQL connection string: postgresql://<username>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/placementos?schema=public"

# JWT configuration
JWT_SECRET="placementos-super-secret-jwt-key-2026-production-ready"
JWT_EXPIRES_IN="7d"

# Client origin for CORS
CLIENT_URL="http://localhost:3000"
